# =============================================================================
# .gitignore - Hotel Booking Behavior Segmentation
# The raw dataset is NOT tracked (download it from Kaggle - see README).
# Regenerable intermediates are ignored too.
# =============================================================================

# --- Raw data (download from Kaggle, see README) -----------------------------
data/raw/*
!data/raw/.gitkeep

# --- Processed data (regenerate by running notebooks 02-13) ------------------
data/processed/*
!data/processed/.gitkeep

# --- Large model artifacts (regenerate by running notebooks 08, 09, 10) ------
models/kmeans_candidate_models.joblib
models/agglomerative_candidate_models.joblib
models/density_candidate_models.joblib

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# --- Virtual environments ----------------------------------------------------
venv/
.venv/
env/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/

# --- Streamlit ---------------------------------------------------------------
.streamlit/secrets.toml

# --- Environment / secrets ---------------------------------------------------
.env
*.pem
*.key

# --- IDE ---------------------------------------------------------------------
.vscode/
.idea/

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs --------------------------------------------------------------------
*.log